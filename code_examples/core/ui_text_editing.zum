import "../../std/desktop.zum" as desktop;
import "../../std/ui.zum" as ui;
var app << desktop.app({"backend": "headless", "name": "Text editing"});
var window << app.window({"title": "Text editing", "width": 420, "height": 180});
var state << ui.stringState("Alpha beta");
var input << ui.input({"id": "editor", "value": "Alpha beta", "width": 300, "height": 40});
ui.bind(input, "value", state);
var context << ui.mount(app, window, ui.containerWith({"padding": 20}, [input]), {"theme": ui.theme("light")});
context.focus(input);
context.dispatch({"type": "key_down", "key": "A", "shortcut": "ctrl+a"});
context.dispatch({"type": "key_down", "key": "C", "shortcut": "ctrl+c"});
context.dispatch({"type": "text_input", "text": "Gamma"});
context.dispatch({"type": "key_down", "key": "Home", "shortcut": "home"});
context.dispatch({"type": "key_down", "key": "Right", "shortcut": "right"});
context.dispatch({"type": "key_down", "key": "Right", "shortcut": "shift+right"});
context.dispatch({"type": "text_input", "text": "X"});
context.dispatch({"type": "key_down", "key": "End", "shortcut": "end"});
context.dispatch({"type": "key_down", "key": "V", "shortcut": "ctrl+v"});
context.dispatch({"type": "key_down", "key": "A", "shortcut": "ctrl+a"});
context.dispatch({"type": "key_down", "key": "X", "shortcut": "ctrl+x"});
context.dispatch({"type": "key_down", "key": "V", "shortcut": "ctrl+v"});
show(state.get());
show(input.get("caretIndex"));
show(input.get("selectionStart"));
context.close();
app.close();
