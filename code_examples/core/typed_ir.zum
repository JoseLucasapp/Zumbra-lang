const START << 5;

struct Counter {
    value: int;

    fct add(amount) {
        self.value << self.value + amount;
    }
}

enum Mode {
    Idle;
    Running;
}

var folded << 2 + 3 * 4;
var counter << Counter(START);
counter.add(folded);

var mode << Mode.Running;
var label << match(mode) {
    case Mode.Idle {
        "idle";
    }
    case Mode.Running {
        "running";
    }
    else {
        "unknown";
    }
};

show(folded);
show(counter.value);
show(label);
